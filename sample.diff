+def find_user(username, roles=[]):
+    conn = sqlite3.connect(DB_PATH)
+    cur = conn.cursor()
+    query = "SELECT * FROM users WHERE username = '" + username + "'"
+    cur.execute(query)
+    row = cur.fetchone()
+    conn.close()
+    return row
+
+
+def is_admin(user):
+    if user["role"] is "admin":
+        return True
+    return False
+
+
+def average_score(scores):
+    total = 0
+    for score in scores:
+        total += score
+    return total / len(scores)
+
+
+def add_role(user, role):
+    roles = user.get("roles", [])
+    roles.append(role)
+    return roles
